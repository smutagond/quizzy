# -------------------------------------------------------------
# Quizzy Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# -------------------------------------------------------------

# Admin authentication password for hosting live quiz rooms
ADMIN_PASSWORD=your_secure_admin_password_here

# Realtime Socket.IO server configuration
# Port for the Realtime server (defaults to 4001)
REALTIME_PORT=4001

# Next.js server-side rewrite destination to the realtime server (defaults to http://127.0.0.1:4001)
# REALTIME_SERVER_URL=http://127.0.0.1:4001

# Public URL for the Realtime server if hosted separately from the frontend
# NEXT_PUBLIC_REALTIME_URL=https://realtime.yourdomain.com

# Allowed CORS origins for Socket.IO (comma-separated, or leave unset to allow same-origin / all)
# WEB_ORIGIN=https://quizzy.yourdomain.com,http://localhost:3000
